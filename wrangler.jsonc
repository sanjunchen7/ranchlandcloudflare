{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ranchland-villa-motel",
  "main": "api/boot.ts",
  "compatibility_date": "2026-04-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ranchland-villa-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "EMAIL_FROM": "reservations@ranchlandvilla.ca"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "ranchland-villa-motel",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_YOUR_HYPERDRIVE_ID"
        }
      ]
    }
  }
}

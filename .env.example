# Direct MySQL connection used by Drizzle migration and seed scripts only.
# Never commit the real value. Production Workers use the HYPERDRIVE binding.
DATABASE_URL=mysql://user:password@host:3306/database

# Required only when seeding a staff account that does not already exist.
# Use unique random values; no public default password is provided.
ADMIN_INITIAL_PASSWORD=
FRONTDESK_INITIAL_PASSWORD=
